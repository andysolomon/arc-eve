# Eve parent provider settings. Copy to .env.local and fill in. .env.local is
# gitignored (.env.* pattern) and is bootstrapped into process.env at agent
# module load; real process environment always wins over file values.
EVE_PARENT_PROVIDER=openai
EVE_PARENT_MODEL=gpt-5-mini

# Leave blank for AI Gateway routing (Eve resolves model metadata itself).
# Set to an OpenAI-compatible base URL to route the parent model directly,
# e.g. https://api.minimax.io/v1 . Direct routing sends the model to
# <base>/chat/completions and requires the context-window value below.
EVE_PARENT_BASE_URL=
EVE_PARENT_API_KEY=replace-with-a-parent-provider-key

# Required only for direct routing (EVE_PARENT_BASE_URL set): Eve compiles its
# compaction trigger from this and cannot fall back to AI Gateway metadata for
# a non-gateway provider. Omit to use the conservative built-in default of
# 128000 tokens; raise it to match the provider's real window.
# EVE_PARENT_MODEL_CONTEXT_WINDOW_TOKENS=128000

# Eve string models consume this compatibility alias for gateway auth.
# AI_GATEWAY_API_KEY=replace-with-a-gateway-key
